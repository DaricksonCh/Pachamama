{
  "name": "pachamama",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @pachamama/api\" \"npm run dev -w @pachamama/web\"",
    "build": "npm run build -w @pachamama/api && npm run build -w @pachamama/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:e2e": "npm run test:e2e -w @pachamama/web",
    "db:check": "npm run db:check -w @pachamama/api",
    "check:all": "npm run check && npm run build && npm run test:e2e",
    "db:migrate": "npm run db:migrate -w @pachamama/api",
    "db:migrate:down": "npm run db:migrate:down -w @pachamama/api",
    "admin:create": "npm run admin:create -w @pachamama/api --",
    "db:cleanup": "npm run db:cleanup -w @pachamama/api",
    "db:seed:menu": "npm run db:seed:menu -w @pachamama/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}

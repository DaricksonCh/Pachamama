{
  "name": "@pachamama/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:down": "tsx scripts/migrate.ts down",
    "admin:create": "tsx scripts/create-admin.ts",
    "e2e:seed": "tsx scripts/e2e-seed.ts",
    "e2e:serve": "tsx scripts/e2e-server.ts",
    "db:cleanup": "tsx scripts/cleanup.ts"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.7.27",
    "@pachamama/shared": "^0.0.0",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.27",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "kysely": "^0.29.9",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "unpdf": "^2.2.1"
  }
}

# Copia este archivo como .env y rellena los valores. Nunca subas .env a Git.
# Las variables se irán completando por fases (ver docs/roadmap.md).

# --- Fase 2: API ---
NODE_ENV=development
API_PORT=3000
# Opcional: fatal, error, warn, info, debug, trace, silent
# LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:5173
# Producción: API_HOST=127.0.0.1 (solo accesible a través de nginx)
# API_HOST=127.0.0.1
# Proxies de confianza para X-Forwarded-For (por defecto: loopback)
# TRUST_PROXY=loopback

# --- Fase 3: base de datos y autenticación ---
DATABASE_URL=mysql://pachamama:CHANGE_ME@127.0.0.1:3307/pachamama
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# URL pública de la API (en producción, el dominio con https)
BETTER_AUTH_URL=http://localhost:3000
# Opcional: BD de tests (por defecto, la de DATABASE_URL con el nombre pachamama_test)
# TEST_DATABASE_URL=mysql://pachamama:CHANGE_ME@127.0.0.1:3307/pachamama_test

# --- Fase 7+: emails (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pachamama <no-reply@example.com>"
STAFF_NOTIFY_EMAIL=

# Carpeta de las fotos subidas de la carta (se sirve en /uploads). En producción: fuera del repo y con copia de seguridad.
# En producción usa una ruta ABSOLUTA (p. ej. /var/lib/pachamama/uploads): la relativa depende del directorio de arranque.
UPLOADS_DIR=./uploads

# Límites de peticiones por IP (opcional; valores por defecto). En tests/e2e se suben solos.
# RATE_LIMIT_API_PER_MIN=300
# RATE_LIMIT_IMAGE_PER_10MIN=30
# RATE_LIMIT_PDF_PER_MIN=30
